# ==========================================
# Bitechez POS - Root Environment Template
# Copy to .env or .env.local for local overrides
# DO NOT COMMIT REAL SECRETS
# ==========================================

APP_ENV=development
APP_NAME=Bitechez POS
APP_VERSION=1.0.0
LOG_LEVEL=info

# Outlet & Device Identification
TENANT_ID=00000000-0000-0000-0000-000000000001
OUTLET_ID=11111111-1111-1111-1111-111111111111
DEVICE_ID=22222222-2222-2222-2222-222222222222
STATION_TYPE=cashier-terminal # cashier-terminal | kitchen-display | standalone

# Local Restaurant Server Settings
LOCAL_SERVER_HOST=127.0.0.1
LOCAL_SERVER_PORT=3001
LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/bitechez_local
SOCKET_URL=http://127.0.0.1:3001

# Desktop Local Terminal SQLite Database
DESKTOP_SQLITE_PATH=./bitechez_terminal.sqlite

# Cloud Platform Settings
CLOUD_API_URL=http://127.0.0.1:3002
CLOUD_DATABASE_URL=postgres://postgres:postgres@localhost:5432/bitechez_cloud
CLOUD_SYNC_ENABLED=true
SYNC_INTERVAL=5000

# Hardware & Printing
PRINTER_DEFAULT=EPSON_TM_T82_USB
PRINTER_PAPER_WIDTH=80mm # 58mm | 80mm
KITCHEN_PRINTER_IP=192.168.1.200
KITCHEN_PRINTER_PORT=9100

# Vite Public Environment Variables (Renderer ONLY)
VITE_APP_NAME="Bitechez POS"
VITE_APP_VERSION="1.0.0"
VITE_LOCAL_SERVER_URL="http://127.0.0.1:3001"
VITE_DEFAULT_CURRENCY="INR"
VITE_CURRENCY_SYMBOL="₹"
